package views

import (
	"fmt"
	"time"

	"github.com/sgaunet/s3xplorer/pkg/config"
	"github.com/sgaunet/s3xplorer/pkg/dto"
)

// BucketSelection lists the discovered S3 buckets and lets the user switch to one.
templ BucketSelection(buckets []dto.Bucket, currentBucket string, cfg config.Config) {
	@Layout(PageOpts{
		Title:      "s3xplorer - Select Bucket",
		ActivePage: "buckets",
	}, cfg) {
		<div class="mb-5">
			<h1 class="title is-4 is-flex is-align-items-center is-gap-2">
				@Icon("database", "has-text-link")
				<span>Select a bucket to explore</span>
			</h1>
			if currentBucket != "" {
				<div class="notification is-info is-light">
					<strong>Current bucket:</strong> { currentBucket }
				</div>
			}
		</div>
		if len(buckets) == 0 {
			@EmptyState(
				"database",
				"No buckets available",
				"No S3 buckets are currently accessible. The background scanner may not have run yet, or all buckets are inaccessible with current credentials.",
			)
			<div class="has-text-centered">
				<a class="button" href="/">
					@Icon("home", "is-small")
					<span class="ml-2">Return to Home</span>
				</a>
			</div>
		} else {
			<div class="table-container">
				<table class="table is-fullwidth is-hoverable is-striped" role="grid" aria-label="Available S3 buckets">
					<thead>
						<tr role="row">
							<th role="columnheader">Bucket Name</th>
							<th class="is-narrow" role="columnheader">Status</th>
							<th class="is-narrow" role="columnheader">Created</th>
							<th class="is-narrow" role="columnheader">Action</th>
						</tr>
					</thead>
					<tbody>
						for _, bucket := range buckets {
							<tr role="row">
								<td role="gridcell">
									<span class="has-text-weight-semibold">{ bucket.Name }</span>
									if bucket.Region != "" {
										<p class="help has-text-weak">Region: { bucket.Region }</p>
									}
								</td>
								<td class="is-narrow" role="gridcell">
									if bucket.IsAccessible {
										@StatusBadge("accessible", "")
									} else {
										@StatusBadge("inaccessible", bucket.AccessError)
									}
								</td>
								<td class="is-narrow" role="gridcell">
									<time
										datetime={ bucket.CreationDate.Format(time.RFC3339) }
										title={ bucket.CreationDate.Format(time.RFC3339) }
									>
										{ formatRelativeTime(bucket.CreationDate) }
									</time>
									<p class="help has-text-weak">{ formatDateTime(bucket.CreationDate) }</p>
								</td>
								<td class="is-narrow" role="gridcell">
									if bucket.IsAccessible {
										<a
											class="button is-link is-small"
											href={ templ.SafeURL(fmt.Sprintf("/?switchBucket=%s", bucket.Name)) }
											aria-label={ fmt.Sprintf("Select bucket %s", bucket.Name) }
										>
											Select
										</a>
									} else {
										<button class="button is-small" disabled aria-label="Bucket unavailable" type="button">
											Unavailable
										</button>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}
