package views

import (
	"fmt"

	"github.com/sgaunet/s3xplorer/pkg/config"
	"github.com/sgaunet/s3xplorer/pkg/dto"
)

// RenderIndexHierarchical renders one page of a folder's contents, with folders
// listed before files.
templ RenderIndexHierarchical(Folders []dto.S3Object, Files []dto.S3Object, ActualFolder string, Breadcrumbs []dto.Breadcrumb, cfg config.Config, Paging *dto.PaginationInfo) {
	@Layout(PageOpts{
		Title:      "s3xplorer",
		ActivePage: "home",
	}, cfg) {
		@breadcrumbNav(Breadcrumbs)
		<div class="level mb-4">
			<div class="level-left">
				<div class="level-item">
					<span class="is-flex is-align-items-center is-gap-1 mr-4">
						@Icon("folder", "is-small has-text-link")
						<strong>{ fmt.Sprintf("%d", len(Folders)) }</strong>
						<span class="has-text-weak">folder(s)</span>
					</span>
					<span class="is-flex is-align-items-center is-gap-1">
						@Icon("file", "is-small has-text-weak")
						<strong>{ fmt.Sprintf("%d", len(Files)) }</strong>
						<span class="has-text-weak">file(s) on this page</span>
					</span>
				</div>
			</div>
			<div class="level-right">
				<div class="level-item">
					<div class="buttons">
						if cfg.S3.EnableUpload {
							<button
								class="button is-link"
								onclick="document.getElementById('upload-form').classList.toggle('is-hidden')"
								aria-label="Upload file"
								type="button"
							>
								@Icon("upload", "is-small")
								<span class="ml-2">Upload</span>
							</button>
						}
						if cfg.S3.EnableDelete && len(Files) > 0 {
							<button
								id="delete-button"
								class="button is-danger"
								onclick="submitDeleteForm()"
								disabled
								aria-label="Delete selected files"
								type="button"
							>
								@Icon("trash", "is-small")
								<span class="ml-2">Delete Selected (<span id="delete-count">0</span>)</span>
							</button>
						}
					</div>
				</div>
			</div>
		</div>
		if cfg.S3.EnableUpload {
			<div id="upload-form" class="box is-hidden">
				<form action="/upload" method="POST" enctype="multipart/form-data">
					<input type="hidden" name="folder" value={ ActualFolder }/>
					<div class="field">
						<label class="label" for="file-input">Select file to upload</label>
						<div class="control">
							<input class="input" type="file" id="file-input" name="file" required/>
						</div>
					</div>
					<div class="buttons">
						<button class="button is-link" type="submit">Upload</button>
						<button
							class="button"
							type="button"
							onclick="document.getElementById('upload-form').classList.add('is-hidden')"
						>
							Cancel
						</button>
					</div>
				</form>
			</div>
		}
		if cfg.S3.EnableDelete {
			<form id="delete-form" class="is-hidden" action="/delete" method="POST">
				<input type="hidden" name="folder" value={ ActualFolder }/>
				<div id="delete-keys-container"></div>
			</form>
		}
		if len(Folders) == 0 && len(Files) == 0 {
			@EmptyState("inbox", "This folder is empty", "No files or folders found")
		} else {
			<div class="table-container is-sticky-head">
				<table class="table is-fullwidth is-hoverable is-striped" role="grid" aria-label="Files and folders">
					<thead>
						<tr role="row">
							if cfg.S3.EnableDelete {
								<th class="is-narrow" role="columnheader">
									<input
										class="checkbox"
										type="checkbox"
										id="select-all"
										onchange="toggleAllCheckboxes(this.checked)"
										aria-label="Select all files"
									/>
								</th>
							}
							<th class="is-narrow" role="columnheader"><span class="is-sr-only">Type</span></th>
							<th role="columnheader">Name</th>
							<th class="is-narrow" role="columnheader">Size</th>
							<th class="is-narrow" role="columnheader">ETag</th>
							<th class="is-narrow" role="columnheader">Modified</th>
							<th class="is-narrow" role="columnheader">Storage</th>
							<th class="is-narrow" role="columnheader">Actions</th>
						</tr>
					</thead>
					<tbody>
						for _, obj := range Folders {
							<tr role="row">
								if cfg.S3.EnableDelete {
									<td class="is-narrow" role="gridcell"></td>
								}
								<td class="is-narrow has-text-centered" role="gridcell">
									@Icon("folder", "has-text-link")
								</td>
								<td role="gridcell">
									<a
										class="has-text-weight-semibold"
										href={ folderURL(obj.Key) }
										aria-label={ fmt.Sprintf("Open folder: %s", obj.Name) }
									>
										{ obj.Name }
									</a>
								</td>
								<td class="is-narrow" role="gridcell">@emptyCell()</td>
								<td class="is-narrow" role="gridcell">@emptyCell()</td>
								<td class="is-narrow" role="gridcell">@emptyCell()</td>
								<td class="is-narrow" role="gridcell">@emptyCell()</td>
								<td class="is-narrow" role="gridcell"></td>
							</tr>
						}
						for _, obj := range Files {
							<tr role="row">
								if cfg.S3.EnableDelete {
									<td class="is-narrow" role="gridcell">
										<input
											class="checkbox file-checkbox"
											type="checkbox"
											data-key={ obj.Key }
											onchange="updateDeleteButton()"
											aria-label={ fmt.Sprintf("Select %s", obj.Name) }
										/>
									</td>
								}
								<td class="is-narrow has-text-centered" role="gridcell">
									@Icon(getFileIconName(obj.Name), "has-text-weak")
								</td>
								<td role="gridcell">
									if obj.IsDownloadable {
										<a href={ downloadURL(obj.Key) }>{ obj.Name }</a>
									} else {
										<span class="has-text-weight-medium">{ obj.Name }</span>
									}
									<p class="mt-1"><span class="tag is-small">{ getFileTypeLabel(obj.Name) }</span></p>
								</td>
								<td class="is-narrow" role="gridcell">
									<span class="has-text-weight-medium">{ obj.SizeHuman }</span>
								</td>
								<td class="is-narrow" role="gridcell" title={ obj.ETag }>
									<code>{ truncateETag(obj.ETag, etagCellLength) }</code>
								</td>
								<td class="is-narrow" role="gridcell">
									@modifiedCell(obj)
								</td>
								<td class="is-narrow" role="gridcell">
									<span class="tag is-rounded">{ obj.StorageClass }</span>
								</td>
								<td class="is-narrow" role="gridcell">
									@objectActions(obj, ActualFolder, cfg)
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			@PaginationControls(Paging, ActualFolder)
		}
	}
}

// breadcrumbNav renders the folder path as a Bulma breadcrumb. Separators are
// drawn by CSS, so no manual delimiters are needed.
templ breadcrumbNav(crumbs []dto.Breadcrumb) {
	<nav class="breadcrumb" aria-label="breadcrumb">
		<ul>
			for i, crumb := range crumbs {
				<li class={ templ.KV("is-active", i == len(crumbs)-1) }>
					if i == len(crumbs)-1 {
						<span class="px-2 has-text-weight-semibold" aria-current="page">{ crumb.Name }</span>
					} else {
						<a href={ folderURL(crumb.Path) }>
							if i == 0 {
								@Icon("home", "is-small")
								<span class="ml-1">{ crumb.Name }</span>
							} else {
								{ crumb.Name }
							}
						</a>
					}
				</li>
			}
		</ul>
	</nav>
}
