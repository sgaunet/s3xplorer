package views

import (
	"time"

	"github.com/sgaunet/s3xplorer/pkg/config"
)

// RenderDatabaseUnavailable renders the degraded-mode page shown when the
// database cannot be reached. It auto-refreshes so the page recovers on its own.
templ RenderDatabaseUnavailable() {
	@Layout(PageOpts{
		Title:       "Database Unavailable - s3xplorer",
		Container:   ContainerMedium,
		RefreshSecs: 30,
	}, config.Config{}) {
		<div class="box">
			<header class="has-text-centered mb-5">
				@Icon("alert-triangle", "is-large has-text-danger")
				<h1 class="title is-3 has-text-danger mt-3 mb-2">Database Unavailable</h1>
				<p class="has-text-weak">
					The database is currently unavailable. S3xplorer is running in degraded mode.
				</p>
			</header>
			<div class="content">
				@healthPoint("check-circle", "has-text-success", "S3 direct operations are still available")
				@healthPoint("x-circle", "has-text-danger", "Bucket scanning and metadata features are disabled")
				@healthPoint("loader", "has-text-link is-spinning", "The application will automatically reconnect when the database is available")
			</div>
			<footer class="has-text-centered">
				<div class="buttons is-centered">
					<a class="button is-link" href="/health/database">
						@Icon("database", "is-small")
						<span class="ml-2">Check Database Status</span>
					</a>
					<a class="button" href="/">
						@Icon("home", "is-small")
						<span class="ml-2">Return to Home</span>
					</a>
				</div>
				<p class="help has-text-weak is-italic">This page will auto-refresh every 30 seconds</p>
			</footer>
		</div>
	}
}

// RenderDatabaseHealthy renders the database health confirmation page.
templ RenderDatabaseHealthy(lastCheck time.Time) {
	@Layout(PageOpts{
		Title:     "Database Health - s3xplorer",
		Container: ContainerMedium,
	}, config.Config{}) {
		<div class="box">
			<header class="has-text-centered mb-5">
				@Icon("check-circle", "is-large has-text-success")
				<h1 class="title is-3 has-text-success mt-3 mb-2">Database Healthy</h1>
				<p class="has-text-weak">The database connection is working correctly.</p>
			</header>
			<div class="notification has-text-centered">
				<p class="heading">Last Check</p>
				<p class="title is-5">{ lastCheck.Format("2006-01-02 15:04:05 UTC") }</p>
			</div>
			<p class="has-text-centered has-text-success mb-5 is-flex is-align-items-center is-justify-content-center is-gap-2">
				@Icon("check-circle", "is-small")
				<span>All s3xplorer features are fully operational</span>
			</p>
			<footer class="has-text-centered">
				<div class="buttons is-centered">
					<a class="button is-link" href="/health">
						@Icon("info", "is-small")
						<span class="ml-2">View Full Health Status</span>
					</a>
					<a class="button" href="/">
						@Icon("home", "is-small")
						<span class="ml-2">Return to Home</span>
					</a>
				</div>
			</footer>
		</div>
	}
}

// healthPoint renders one status line in the degraded-mode checklist.
templ healthPoint(icon string, color string, text string) {
	<div class="is-flex is-align-items-flex-start is-gap-2 mb-3">
		@Icon(icon, color)
		<span>{ text }</span>
	</div>
}
