package views

import (
	"fmt"

	"github.com/sgaunet/s3xplorer/pkg/config"
	"github.com/sgaunet/s3xplorer/pkg/dto"
)

// RenderSearch renders the search form and its results.
templ RenderSearch(searchStr string, folder string, objects []dto.S3Object, cfg config.Config) {
	@Layout(PageOpts{
		Title:      "Search - s3xplorer",
		ActivePage: "search",
	}, cfg) {
		<form class="mb-5" action="/search">
			<div class="field">
				<label class="label is-medium" for="searchstr">Search files and folders</label>
				<div class="field has-addons">
					<div class="control is-expanded has-icons-left">
						<input
							class="input is-medium"
							type="text"
							id="searchstr"
							name="searchstr"
							placeholder="Enter search term..."
							value={ searchStr }
							autofocus
							autocomplete="off"
							aria-label="Search files and folders"
						/>
						<span class="icon is-left">
							<svg aria-hidden="true"><use href="/static/icons.svg#search"></use></svg>
						</span>
					</div>
					<div class="control">
						<button class="button is-link is-medium" type="submit">Search</button>
					</div>
				</div>
				<p class="help">
					<kbd>Ctrl</kbd> + <kbd>K</kbd> to focus search
				</p>
			</div>
		</form>
		if searchStr != "" {
			<p class="mb-5 is-flex is-align-items-center is-gap-2">
				<span class="tag is-link is-medium">{ fmt.Sprintf("%d", len(objects)) }</span>
				<span class="has-text-weak">
					result(s) for <em class="has-text-weight-semibold">{ searchStr }</em>
				</span>
			</p>
		}
		if len(objects) > 0 {
			<div class="table-container is-sticky-head">
				<table class="table is-fullwidth is-hoverable is-striped" role="grid" aria-label="Search results">
					<thead>
						<tr role="row">
							<th class="is-narrow" role="columnheader"><span class="is-sr-only">Type</span></th>
							<th role="columnheader">Name</th>
							<th class="is-narrow" role="columnheader">Size</th>
							<th class="is-narrow" role="columnheader">Modified</th>
							<th class="is-narrow" role="columnheader">Storage</th>
							<th class="is-narrow" role="columnheader">Actions</th>
						</tr>
					</thead>
					<tbody>
						for _, obj := range objects {
							<tr role="row">
								<td class="is-narrow has-text-centered" role="gridcell">
									if obj.IsFolder {
										@Icon("folder", "has-text-link")
									} else {
										@Icon(getFileIconName(obj.Name), "has-text-weak")
									}
								</td>
								<td role="gridcell">
									if obj.IsFolder {
										<a
											class="has-text-weight-semibold"
											href={ folderURL(obj.Key) }
											aria-label={ fmt.Sprintf("Open folder: %s", obj.Key) }
										>
											{ obj.Key }
										</a>
									} else {
										if obj.IsDownloadable {
											<a href={ downloadURL(obj.Key) }>{ obj.Key }</a>
										} else {
											<span class="has-text-weight-medium">{ obj.Key }</span>
										}
										<p class="mt-1"><span class="tag is-small">{ getFileTypeLabel(obj.Key) }</span></p>
									}
								</td>
								<td class="is-narrow" role="gridcell">
									if obj.IsFolder {
										@emptyCell()
									} else {
										<span class="has-text-weight-medium">{ formatSize(obj.Size) }</span>
									}
								</td>
								<td class="is-narrow" role="gridcell">
									if obj.IsFolder {
										@emptyCell()
									} else {
										@modifiedCell(obj)
									}
								</td>
								<td class="is-narrow" role="gridcell">
									if obj.IsFolder {
										@emptyCell()
									} else {
										<span class="tag is-rounded">{ obj.StorageClass }</span>
									}
								</td>
								<td class="is-narrow" role="gridcell">
									if !obj.IsFolder {
										@objectActions(obj, folder, cfg)
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		} else if searchStr != "" {
			@EmptyState("search", "No results found", "Try a different search term or check your spelling")
		}
	}
}
