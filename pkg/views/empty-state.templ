package views

// EmptyState renders a centered placeholder for an empty listing or result set.
templ EmptyState(icon string, title string, description string) {
	<div class="s3x-empty p-5">
		@Icon(icon, "is-large has-text-weak")
		<h3 class="title is-5 mt-4 mb-2">{ title }</h3>
		<p class="has-text-weak">{ description }</p>
	</div>
}
