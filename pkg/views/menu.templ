package views

import "github.com/sgaunet/s3xplorer/pkg/config"

// MenuWithConfig renders the top navigation bar, hiding the bucket link when
// the app is locked to a single bucket.
templ MenuWithConfig(cfg config.Config, activePage string) {
	<nav class="navbar is-spaced has-shadow" role="navigation" aria-label="Main navigation">
		<div class="container is-max-widescreen">
			<div class="navbar-brand">
				<a class="navbar-item has-text-weight-semibold is-size-5" href="/" aria-label="s3xplorer home">
					@Icon("folder-archive", "has-text-link")
					<span class="ml-2">s3xplorer</span>
				</a>
				<button
					class="navbar-burger"
					data-target="navbar-menu"
					aria-label="Toggle navigation menu"
					aria-expanded="false"
					aria-controls="navbar-menu"
					type="button"
				>
					<span aria-hidden="true"></span>
					<span aria-hidden="true"></span>
					<span aria-hidden="true"></span>
					<span aria-hidden="true"></span>
				</button>
			</div>
			<div id="navbar-menu" class="navbar-menu">
				<div class="navbar-start">
					@navItem("/", "home", "Home", "home", activePage)
					@navItem("/search", "search", "Search", "search", activePage)
					if !cfg.S3.BucketLocked {
						@navItem("/buckets", "database", "Buckets", "buckets", activePage)
					}
				</div>
				<div class="navbar-end">
					<div class="navbar-item">
						<button
							id="theme-toggle"
							class="button is-ghost"
							aria-label="Toggle dark mode"
							onclick="toggleTheme()"
							type="button"
						>
							@Icon("sun", "theme-icon-light")
							@Icon("moon", "theme-icon-dark")
						</button>
					</div>
				</div>
			</div>
		</div>
	</nav>
}

// navItem renders one navbar link, marking it active when it is the current page.
templ navItem(href templ.SafeURL, icon string, label string, page string, activePage string) {
	<a
		class={ "navbar-item", templ.KV("is-active has-text-weight-semibold", page == activePage) }
		href={ href }
		if page == activePage {
			aria-current="page"
		}
	>
		@Icon(icon, "is-small")
		<span class="ml-2">{ label }</span>
	</a>
}
