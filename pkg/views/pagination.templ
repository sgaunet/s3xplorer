package views

import (
	"fmt"
	"net/url"

	"github.com/sgaunet/s3xplorer/pkg/dto"
)

// PaginationControls renders previous/next navigation plus a page summary.
// Disabled edges use Bulma's is-disabled modifier rather than swapping the
// element out, so the control keeps a stable shape across pages.
templ PaginationControls(paging *dto.PaginationInfo, folderPath string) {
	if paging.TotalPages > 1 {
		<nav class="pagination is-centered mt-5" role="navigation" aria-label="Pagination">
			if paging.HasPrevious {
				<a
					class="pagination-previous"
					href={ pageURL(folderPath, paging.CurrentPage-1) }
					aria-label="Go to previous page"
				>
					Previous
				</a>
			} else {
				<span class="pagination-previous" disabled aria-disabled="true">Previous</span>
			}
			if paging.HasNext {
				<a
					class="pagination-next"
					href={ pageURL(folderPath, paging.CurrentPage+1) }
					aria-label="Go to next page"
				>
					Next
				</a>
			} else {
				<span class="pagination-next" disabled aria-disabled="true">Next</span>
			}
			<ul class="pagination-list">
				<li>
					<span class="has-text-weak is-size-7">
						Page <strong>{ fmt.Sprintf("%d", paging.CurrentPage) }</strong>
						of <strong>{ fmt.Sprintf("%d", paging.TotalPages) }</strong>
						&nbsp;&bull;&nbsp;
						<strong>{ fmt.Sprintf("%d", paging.TotalItems) }</strong> items
					</span>
				</li>
			</ul>
		</nav>
	}
}

// pageURL builds a listing URL for a folder at a given page.
func pageURL(folderPath string, page int) templ.SafeURL {
	return templ.SafeURL(fmt.Sprintf("/?folder=%s&page=%d", url.QueryEscape(folderPath), page))
}
